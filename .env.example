# --- Fuel data ---
# Optional: enables a real FBO fuel vendor feed. Without these, fuel prices
# come only from Supabase pilot reports, or show as unavailable.
AIRNAV_API_KEY=
AIRNAV_API_URL=

# --- Supabase (required for pilot fuel price reports to persist) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- NOTAMs ---
# Optional: without these, /api/notams returns clearly tagged demo data,
# and the app hides the NOTAM flag from public view until real credentials exist.
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# --- Ads ---
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9654534364634754

# --- Analytics ---
# Required for the Plausible script to load at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Map ---
# Optional: removes the CARTO watermark on dark map tiles.
NEXT_PUBLIC_CARTO_API_KEY=

# --- Site identity (required before launch) ---
NEXT_PUBLIC_SITE_NAME=AvADSB
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=info@avadsb.com